# Development only: choose your own password before exposing any service.
POSTGRES_USER=runaway
POSTGRES_PASSWORD=runaway_local_only
POSTGRES_DB=runaway
DATABASE_URL=postgresql+psycopg://runaway:runaway_local_only@localhost:5432/runaway
LLM_PROVIDER=fake

# Origins allowed to call the API from a browser, comma separated, exact (scheme, host, port).
# Empty in local development: the Vite proxy serves the API on the same origin.
# "*" is refused at startup. Example: CORS_ORIGINS=https://runaway.example,https://www.runaway.example
CORS_ORIGINS=

# Trip creations (POST /trips and POST /trips/example share the quota), in memory, per API process.
RATE_LIMIT_CREATIONS_PER_IP=10
RATE_LIMIT_CREATIONS_GLOBAL=200
RATE_LIMIT_WINDOW_SECONDS=3600

# A trip nobody opened for this many months can be purged with: python -m app.retention --apply
RETENTION_MONTHS=12

# JSON logs on stderr: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Frontend, only when the API is on another origin than the site (read at build time by Vite).
# Put it in frontend/.env.production or set it as a variable of the build.
# VITE_API_URL=https://api.runaway.example
