# Copy to .env.prod at the repository root on the server, then fill in. .env.prod is ignored by Git.
# chmod 600 .env.prod

# Public domain, whose DNS A record points to the server.
DOMAIN=runaway.example.org
# Address that Let's Encrypt uses to warn about certificates.
ACME_EMAIL=contact@example.org

POSTGRES_USER=runaway
POSTGRES_DB=runaway
# Generate it: openssl rand -hex 32
# Hexadecimal only: the password is placed inside a connection URL.
POSTGRES_PASSWORD=

# Optional. These are the default values.
RATE_LIMIT_CREATIONS_PER_IP=10
RATE_LIMIT_CREATIONS_GLOBAL=200
RATE_LIMIT_WINDOW_SECONDS=3600
RETENTION_MONTHS=12
LOG_LEVEL=INFO
